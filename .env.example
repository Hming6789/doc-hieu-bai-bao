# Khóa Google Gemini API lấy miễn phí tại https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy...

# Mô hình Gemini đa phương thức sử dụng (mặc định: gemini-3.5-flash; tự động dự phòng qua gemini-3.5-flash-lite / gemini-3.8-flash)
GEMINI_MODEL=gemini-3.5-flash

# Thư mục lưu trữ phiên tạm thời (mặc định ./.data; trên Railway/Render gắn Volume vào /data)
DATA_DIR=./.data

# Thời gian lưu phiên tạm thời tính bằng giờ (mặc định: 24)
SESSION_TTL_HOURS=24
